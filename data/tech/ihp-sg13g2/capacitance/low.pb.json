  "description": "Low empirical capacitance coefficients",
  "id": "low",
  "provenance": {
    "assumptions": [
      {
        "description": "Project LV diffusion coefficients to nSD, pSD and Activ; exclude HV-specific coefficients",
        "id": "lv-diffusion",
        "reason": "The current LVS mapping does not select separate HV diffusion rows",
        "source_ids": [
          "extraction-table"
        ]
      },
      {
        "description": "Use cap_carea 1350/1500/1650 aF/um2 while retaining cmim_core CJSW at 40 aF/um",
        "id": "mim-law",
        "reason": "The separate cap_cpara multiplier belongs to another parasitic device and must not scale this edge term",
        "source_ids": [
          "mim-model-1",
          "mim-model-2"
        ]
      },
      {
        "description": "Use same-corner bottom-plate coefficients for MIM coupling to other conductors",
        "id": "mim-thin-plate",
        "reason": "Preserve the existing thin-plate construction independently of the plate-to-plate device law",
        "source_ids": [
          "extraction-table"
        ]
      },
      {
        "description": "No physical-stack, width-bias, transistor-corner or device-reference matching is claimed",
        "id": "capability-limits",
        "reason": "Empirical C coefficients alone do not establish those independent capabilities",
        "source_ids": [
          "extraction-table"
        ]
      }
    ],
    "data_revision": "1",
