  "provenance": {
    "assumptions": [
      {
        "description": "The pass2 field extent is 1.9 um from the top-metal bottom: 1.5 um oxide plus 0.4 um nitride; over-metal and side offsets remain incremental",
        "id": "cumulative-field",
        "reason": "Capiche accumulates field thickness along the coating chain; KPEX stores the extent from the root",
        "source_ids": [
          "capiche-physical"
        ]
      },
      {
        "description": "Interconnect geometry and dielectric recipe from Capiche; not process calibration or a correlation with IHP ITF resistance corners",
        "id": "source-recipe",
        "reason": "Empirical coefficients and physical inputs are independently identified",
        "source_ids": [
          "capiche-physical"
        ]
      },
      {
        "description": "The source qualifies interconnect geometry and materials. Existing device/contact anchors, cut widths and layout connectivity are retained",
        "id": "device-geometry",
        "reason": "Capiche diffusion levels are alternative 2D ground planes, not an active-device physical corner law",
        "source_ids": [
          "recipe",
          "capiche-physical"
        ]
      },
      {
        "description": "The source top background has relative permittivity 3; this is not vacuum and differs from the nominal KPEX background",
        "id": "source-background",
        "reason": "Do not silently replace the selected source material",
        "source_ids": [
          "capiche-physical"
        ]
      }
    ],
