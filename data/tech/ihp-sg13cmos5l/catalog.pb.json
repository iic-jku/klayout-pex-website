  "provenance": {
    "assumptions": [
      {
        "description": "The source maps the selected process stack directories to MAGIC hrlc/lrlc low-C and hrhc/lrhc high-C blocks. The authored physical scenarios retain nominal R, omit device references and retain layout-dependent MIM restrictions",
        "id": "physical-c-pairing",
        "reason": "physical_stack_matches declares the source-related recipe, not identical fitted numbers, a correlated R law or silicon calibration",
        "source_ids": [
          "capiche-magic-mapping",
          "extraction-table"
        ]
      },
      {
        "description": "Physical recipes are pinned to Capiche 85905e8. IHP coefficient revision 14b1ab8 includes the corrected coatings committed four minutes earlier. SKY130/GF180 coefficient files last changed at open_pdks bb8c82e after Capiche bf6bee7 introduced the selected physical profiles; later pinned Capiche changes do not alter their geometry/materials",
        "id": "physical-coefficient-revisions",
        "reason": "Keep recipe and empirical-table revision identities explicit rather than infer a match from names",
        "source_ids": [
          "capiche-magic-mapping",
          "extraction-table"
        ]
      }
    ],
