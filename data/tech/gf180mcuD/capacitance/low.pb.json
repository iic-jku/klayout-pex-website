  "description": "Low empirical capacitance coefficients",
  "id": "low",
  "provenance": {
    "assumptions": [
      {
        "description": "Project LV diffusion coefficients to Nplus, Pplus and COMP; exclude MV-specific coefficients",
        "id": "lv-diffusion",
        "reason": "The current LVS mapping does not select separate MV diffusion rows",
        "source_ids": [
          "extraction-table"
        ]
      },
      {
        "description": "Use the 2 fF/um2 MIM law with 0.9/1.0/1.1 factors on both area and edge terms",
        "id": "mim-law",
        "reason": "The supported stack selects the 2 fF option and its independent device law",
        "source_ids": [
          "mim-model-1",
          "mim-model-2"
        ]
      },
      {
        "description": "Derive low-C Metal2-to-Nwell fringe as 32.657 aF/um from same-corner substrate perimeter",
        "id": "missing-well-fringe",
        "reason": "The source omits this row; substrate and well share the same capacitance plane",
        "source_ids": [
          "extraction-table"
        ]
      },
      {
        "description": "Project Nwell coupling to LVPWELL",
        "id": "well-projection",
        "reason": "Preserve the established nominal layer mapping at each C corner",
        "source_ids": [
          "extraction-table"
        ]
      },
      {
        "description": "Use same-corner bottom-plate coefficients for MIM coupling to other conductors",
        "id": "mim-thin-plate",
        "reason": "The existing thin-plate approximation provides complete non-device coupling rows",
        "source_ids": [
          "extraction-table"
        ]
      },
      {
        "description": "No physical-stack, width-bias, transistor-corner or device-reference matching is claimed",
        "id": "capability-limits",
        "reason": "Empirical C coefficients alone do not establish those independent capabilities",
        "source_ids": [
          "extraction-table"
        ]
      }
    ],
    "data_revision": "1",
    "history": [
      {
