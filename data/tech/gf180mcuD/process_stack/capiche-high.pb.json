  "provenance": {
    "assumptions": [
      {
        "description": "No source physical MIM corner law for profiles metal4_cap, FuseTop",
        "id": "unavailable-mim",
        "reason": "Their retained values serve ordering only. Physical export rejects their extracted shapes or contacts and omits the profiles and dependent coatings otherwise",
        "source_ids": [
          "recipe",
          "capiche-physical"
        ]
      },
      {
        "description": "Source ground height and retained 3D clearance (um): [[\"subs\", 0.0, 0.0]]. The finite conducting thickness retains the nominal KPEX numerical truncation",
        "id": "source-ground-plane",
        "reason": "Capiche specifies an ideal 2D ground surface. SKY130 retains 0.1 um separation from device anchors so the full PEX25D ground plane cannot short their contacts; this is a documented 3D adaptation, not numerical identity with the 2D source",
        "source_ids": [
          "recipe",
          "capiche-physical"
        ]
      },
      {
        "description": "Cut widths and device-contact anchors retain the nominal KPEX contract; vertical interconnect contacts follow the selected conductor faces",
        "id": "contact-geometry",
        "reason": "The source qualifies interconnect geometry/materials, not new via-cut masks or an active-device physical corner law",
        "source_ids": [
          "recipe",
          "capiche-physical"
        ]
      },
      {
        "description": "Coating top/side offsets are incremental; field extents are cumulative from the root metal bottom. Boundary dielectrics retain their source absolute height",
        "id": "field-convention",
        "reason": "This maps the Capiche coating chain and planar boundaries into KPEX physical geometry",
        "source_ids": [
          "capiche-physical"
        ]
      },
      {
        "description": "Physical interconnect recipe only; not a correlated resistance corner, device reference law or silicon calibration",
        "id": "independent-physical-law",
        "reason": "Empirical tables and physical inputs have separate identities and validation",
        "source_ids": [
          "capiche-physical"
        ]
      }
    ],
