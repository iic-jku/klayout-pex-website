{
  "description": "low MIM-only device references",
  "device_references": {
    "devices": [
      {
        "capacitance_references": [
          {
            "capacitance": "area_density*width*length + edge_density*2*(width+length)",
            "description": "mimcap_ff 2 fF/um2 MIM mutual capacitance at zero bias, 25 C and zero mismatch. Area and perimeter follow mim_corner_2p0ff. Excludes leakage conductance. Other MIM options and MOS capacitors are not covered.",
            "parameters": {
              "area_density": "1.791e-15",
              "edge_density": "2.1447e-16",
              "length": "c_length*1e6",
              "width": "c_width*1e6"
            },
            "source": "https://github.com/fossi-foundation/globalfoundries-pdk-libs-gf180mcu_fd_pr/blob/5e4be8726e2ae8be099c4131f697a353d6457874/models/ngspice/sm141064_mim.spice",
            "terminal_names": [
              "B",
              "A"
            ],
            "valid_when": "width>0 && length>0"
          }
        ],
        "lvs_device_class_name": "cap_mim_2f0fF"
      }
    ]
  },
  "id": "low",
  "provenance": {
